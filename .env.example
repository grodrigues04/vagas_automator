# Token da sua assinatura do Claude, gerado com: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Modelo usado na rotina
CLAUDE_MODEL=claude-opus-5-5

# personalWhats: mesma URI e senha de criptografia do personalWhats/.env
MONGO_URI=
ENCRYPTION_PASSWORD=

# Quem recebe o relatório. Vazio = contato padrão do personalWhats
VAGAS_RECIPIENT=
